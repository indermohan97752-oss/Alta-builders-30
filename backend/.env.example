NODE_ENV=development
PORT=4000
# Local Docker MongoDB. Use the application account, never the root account.
# Replace the password with the same MONGO_APP_PASSWORD from the root .env file.
MONGODB_URI=mongodb://chat_app:<replace-with-app-password>@127.0.0.1:27017/chat?authSource=chat
# MongoDB Atlas example (create a database user with readWrite on only this database):
# MONGODB_URI=mongodb+srv://<db_user>:<url_encoded_password>@<cluster-host>/chat?retryWrites=true&w=majority
# A strong secret: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_BASE64_48
CLIENT_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=12
# Set to 1 only when the API is behind exactly one trusted reverse proxy.
TRUST_PROXY=0
# Optional: supply only for one-time schema/index initialization, not normal API runtime.
# MONGODB_ADMIN_URI=mongodb://chat_root:<url_encoded_root_password>@127.0.0.1:27017/chat?authSource=admin
# Postman tooling only. Keep the key private; never put it in frontend code or a ZIP.
POSTMAN_API_KEY=
POSTMAN_WORKSPACE_ID=
